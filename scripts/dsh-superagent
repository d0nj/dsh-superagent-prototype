#!/bin/sh
# Runs the supervisor with a Python that has psutil: `python3` where the platform names it so, `python` otherwise.
here=$(dirname "$0")
if [ -n "$DSH_SUPERAGENT_PYTHON" ]; then
  exec "$DSH_SUPERAGENT_PYTHON" "$here/dsh-superagent.py" "$@"
fi
if command -v python3 >/dev/null 2>&1; then
  exec python3 "$here/dsh-superagent.py" "$@"
fi
exec python "$here/dsh-superagent.py" "$@"
